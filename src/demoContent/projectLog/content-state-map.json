  "operationRules": [
    {
      "operation": "edit-private-code",
      "changes": ["personal-draft"],
      "mustNotChange": ["node-public-snapshot", "task-status", "project-log"]
    },
    {
      "operation": "confirm-submission",
      "changes": ["node-public-snapshot"],
      "mustNotChange": ["task-status-to-completed", "unselected-private-content", "project-log-final-decision"]
    },
    {
      "operation": "confirm-task-completed",
      "changes": ["blueprint-node-status"],
      "mustNotChange": ["publication-selection", "discussion-status", "private-content"]
    },
    {
      "operation": "send-discussion-reply",
      "changes": ["discussion-messages", "waiting-on-member"],
      "mustNotChange": ["task-status", "team-decision-confirmed", "project-log"]
    },
    {
      "operation": "archive-discussion",
      "changes": ["discussion-lifecycle", "team-decision-to-generating-then-draft"],
      "mustNotChange": ["task-status", "team-decision-confirmed"]
    },
    {
      "operation": "confirm-team-decision",
      "changes": ["team-decision-confirmed", "project-log-eligibility"],
      "mustNotChange": ["task-status", "artifact-publication-selection"]
    }
  ],
  "memoryRule": "项目日志只允许引用 submitted 或 seeded_shared 的证据，以及 confirmed 的团队决定。not_submitted 与 draft 内容不得直接进入团队项目日志。"
