# CoTrace AI — server-only. Copy to .env.local and fill DEEPSEEK_API_KEY for live.
# Never commit .env.local. Defaults match server/ai/* code.

# mock | live | (omit)
# - omit: live when DEEPSEEK_API_KEY is set, otherwise mock
# - live: require key (missing key falls back to mock so demo does not crash)
# - mock: force mock samples (used by verify:chain / verify:api / verify:stream)
COTRACE_AI_MODE=live

# Required for live DeepSeek Chat Completions
DEEPSEEK_API_KEY=

# Default model used by deepseekConfig / liveProvider
DEEPSEEK_MODEL=deepseek-flash

# Live call timeout in milliseconds (liveProvider default: 60000)
COTRACE_AI_TIMEOUT_MS=60000
